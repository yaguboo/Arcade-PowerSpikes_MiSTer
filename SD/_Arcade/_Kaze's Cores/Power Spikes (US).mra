<misterromdescription>
    <name>Power Spikes (US)</name>
    <setname>pspikesu</setname>
    <rbf>PowerSpikes</rbf>
    <mameversion>0289</mameversion>
    <year>1991</year>
    <manufacturer>Video System Co.</manufacturer>
    <category>Sports</category>

    <!-- OSD defaults: status[23:0], high byte first.  See OSD_DEFAULTS in
         tools/build_rom.py.  Editing these three bytes changes what the core
         comes up with, with no rebuild. -->
    <rom index="1"><part>00 00 00</part></rom>

    <!-- Generated by tools/build_rom.py.  Do not hand-edit: the region bases
         here and the decode in the RTL come from the same table.

         The interleave maps are VERIFIED, 2026-09-01.  They were unverified
         when this was written - mra-tools' `map` convention could not be
         checked offline and the two plausible readings differ by a byteswap.
         Since then the core boots from this .mra on hardware, runs the whole
         attract sequence, and two board frames came out byte-identical to
         MAME's own frames across all 84,480 pixels.  A byteswapped program
         ROM does not do that.
         The cross-check remains: this script asserts the 68000 reset vector
         before writing roms/*.bin, and debug overlay rows 10-12 read the same
         three words back off hardware.  If they ever disagree, rows 10-12
         read 0x1100 rather than 0x0011 / 0x0000 / 0x0400. -->
    <rom index="0" zip="pspikesu.zip|pspikes.zip" md5="none">
        <!-- maincpu @ 000000 -->
        <interleave output="16">
          <part name="svolly91.73" crc="bfbffcdb" map="12"/>
        </interleave>
        <!-- gfx1 @ 040000 -->
        <part name="g7h" crc="74c23c3d"/>
        <!-- gfx2 @ 0C0000 -->
        <interleave output="32">
          <part name="g7j" crc="0b9e4739" map="0021"/>
          <part name="g7l" crc="943139ff" map="2100"/>
        </interleave>
        <!-- soundbank @ 1C0000 -->
        <part name="19" crc="7e8ed6e5"/>
        <!-- adpcma @ 1E0000 -->
        <part name="o5b" crc="07d6cbac"/>
        <!-- adpcmb @ 2E0000 -->
        <part name="a47" crc="c6779dfa"/>
    </rom>

    <buttons names="A (Action),B,C,Start,Coin,Pause" default="A,B,X,Start,Select,R" count="3"/>

    <!-- NOT FF,FF.  Every DIP on this board defaults to 1 EXCEPT Demo
         Sounds: MAME has PORT_DIPNAME( 0x0040, 0x0000, Demo_Sounds ), and
         that second argument is the default, so the factory setting is
         0 = ON.  With FF,FF the attract is CORRECTLY silent, and the sound
         board then writes key-OFFs and no key-ONs - which reads exactly
         like a dead FM path and cost a long investigation.
         Checked against MAME one DIP at a time; this is the only one that
         differs.  docs/DEBUG_LOG.md. -->
    <switches default="BF,FF" base="0">
        <!-- Transcribed switch by switch from MAME's PORT_START("DSW") for
             pspikes, including the switch positions (SW1:n / SW2:n) and the
             option ORDER.

             An `ids` list is indexed by the RAW VALUE of `bits`, low bit
             first, so it has to be written in that order and not in the order
             MAME lists its PORT_DIPSETTINGs.  Coin A and Coin B were wrong
             here for exactly that reason: MAME lists 3C/1C first because its
             value is 0x0001, but the value-0 entry is 1C/2C. -->
        <!-- SW1 -->
        <dip name="Coin A"                   bits="0,1"   ids="1C/2C,3C/1C,2C/1C,1C/1C"/>
        <dip name="Coin B"                   bits="2,3"   ids="1C/2C,3C/1C,2C/1C,1C/1C"/>
        <dip name="Unused SW1:5"             bits="4"     ids="On,Off"/>
        <dip name="Unused SW1:6"             bits="5"     ids="On,Off"/>
        <dip name="Demo Sounds"              bits="6"     ids="On,Off"/>
        <dip name="Flip Screen"              bits="7"     ids="On,Off"/>
        <!-- SW2 -->
        <dip name="Service Mode"             bits="8"     ids="On,Off"/>
        <dip name="1 Player Starting Score"  bits="9,10"  ids="10-12,11-12,11-11,12-12"/>
        <dip name="2 Players Starting Score" bits="11,12" ids="0-0,5-5,7-7,9-9"/>
        <dip name="Difficulty"               bits="13"    ids="Hard,Normal"/>
        <dip name="2 Players Time Per Credit" bits="14"   ids="2 min,3 min"/>
        <!-- Super Volley '91 PCB Infos reports SW2:8 as "must be off" -->
        <dip name="Debug"                    bits="15"    ids="On,Off"/>
    </switches>
</misterromdescription>
